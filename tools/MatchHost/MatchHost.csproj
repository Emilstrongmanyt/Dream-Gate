    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>Kindling.Tools.MatchHost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\sim\Kindling.Sim\Kindling.Sim.csproj" />
